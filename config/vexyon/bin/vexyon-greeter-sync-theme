#!/usr/bin/env bash
# Sincroniza el tema activo y el idioma de Vexyon con el greeter (greetd).
# El greeter corre ANTES de la sesión de usuario y no puede leer $HOME, así
# que usa snapshots estáticos en /etc/greetd/vexyon-greeter/ (theme.json y
# el campo "lang" de greeter.json). El TEMA lo re-sincroniza solo el bridge
# en cada cambio (theme.json es propiedad del usuario desde install.sh);
# ejecuta esto (pide sudo) para idioma/teclado, o para el tema en
# instalaciones anteriores donde theme.json aún es de root.
set -euo pipefail

CFG="$HOME/.config/vexyon/shell.json"
DEST=/etc/greetd/vexyon-greeter/theme.json
GJSON=/etc/greetd/vexyon-greeter/greeter.json
CURSOR_LUA=/etc/greetd/vexyon-greeter/cursor.lua

active=$(jq -r '.theme.active // empty' "$CFG" 2>/dev/null || true)
if [ -z "$active" ]; then
  echo "No hay tema activo en $CFG" >&2
  exit 1
fi

src="$HOME/.local/share/vexyon/themes/$active.json"
if [ ! -f "$src" ]; then
  echo "Tema '$active' no encontrado en $src" >&2
  exit 1
fi

# -o "$USER": el fichero debe seguir siendo del usuario para que el bridge
# pueda re-sincronizarlo solo en los próximos cambios de tema (sin sudo)
sudo install -Dm644 -o "$USER" "$src" "$DEST"
echo "Greeter → tema '$active' ($DEST)"

lang=$(jq -r '.appearance.language // "en"' "$CFG" 2>/dev/null || echo en)
[ "$lang" = "es" ] || lang="en"
user=$(jq -r '.user // empty' "$GJSON" 2>/dev/null || true)
[ -n "$user" ] || user="$USER"
printf '{ "user": "%s", "lang": "%s" }\n' "$user" "$lang" | sudo tee "$GJSON" >/dev/null
echo "Greeter → idioma '$lang' ($GJSON)"

# teclado del kiosco del greeter = el de la sesión (para la contraseña)
kb=$(jq -r '.behavior.keyboardLayout // "us"' "$CFG" 2>/dev/null || echo us)
case "$kb" in latam|ara|[a-z][a-z]) : ;; *) kb=us ;; esac
if [ -f /etc/greetd/vexyon-greeter/hyprland.lua ]; then
  # Gramática Lua: el valor va entre comillas y con coma final.
  sudo sed -i "s/^\([[:space:]]*kb_layout = \).*/\1\"${kb}\",/" /etc/greetd/vexyon-greeter/hyprland.lua
  echo "Greeter → teclado '$kb'"
fi

# Cursor del greeter = el de la sesión, para que el puntero no cambie de pinta
# al pasar del login al escritorio. Normalmente lo reescribe solo el bridge en
# cada cambio; esto es la vía manual (y la que arregla instalaciones antiguas
# donde cursor.lua aún es de root). La tabla es la misma que CURSOR_THEMES en
# vexyon-bridge.py — mantenerlas en sync. Nunca queda vacía: sin XCURSOR_THEME
# (o con un tema inexistente) Hyprland dibuja su cursor embebido, con forma de
# su logo.
cursor=$(jq -r '.appearance.cursorTheme // "pretty"' "$CFG" 2>/dev/null || echo pretty)
case "$cursor" in
  default|system) cursor_theme="Adwaita" ;;  # "system" era el id viejo sin tema
  black)          cursor_theme="breeze_cursors" ;;
  dmz)            cursor_theme="Vanilla-DMZ" ;;
  capitaine)      cursor_theme="capitaine-cursors" ;;
  *)              cursor_theme="Breeze_Light" ;;  # "pretty" y cualquier id raro
esac
printf -- '-- Vexyon — greeter cursor (GENERATED by vexyon-greeter-sync-theme)\nhl.env("XCURSOR_THEME", "%s")\nhl.env("XCURSOR_SIZE", "24")\n' \
  "$cursor_theme" | sudo tee "$CURSOR_LUA" >/dev/null
sudo chown "$USER" "$CURSOR_LUA"
echo "Greeter → cursor '$cursor_theme' ($CURSOR_LUA)"
